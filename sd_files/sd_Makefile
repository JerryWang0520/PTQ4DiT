summarize_bitwidth:
	mkdir -p $(outdir)
	python summaries/bitwidth_summary.py \
		--input-dir $(indir) \
		--output-dir $(outdir) \
		--distribution-pattern "prompt*/round0/bitwidth/int9_full_distribution_act.csv" \
		--bitwidth-pattern "prompt*/round0/bitwidth/bitwidth_act.csv" \
		--save \
		--stats \
		| tee $(outdir)/bitwidth_summary.log


summarize_bitslice:
	mkdir -p $(outdir)
	python summaries/bitslice_summary.py \
		--input-dir $(indir) \
		--output-dir $(outdir) \
		--pattern "prompt*/round0/bitslice/bitslice_analysis.csv" \
		$(if $(filter True,$(bitslice_overflow)),--bitslice-keep-overflow) \
		--save \
		--stats \
		| tee $(outdir)/bitslice_summary.log

# 		--input-dir output/bitslice/Final \
# 		--output-dir output/summary \

summarize_performance:
	mkdir -p $(outdir)
	python summaries/performance_summary.py \
		--input-dir $(indir) \
		--pattern "prompt*/round0/performance/performance_analysis.csv" \
		--output-dir $(outdir) \
		--save \
		--stats \
		| tee $(outdir)/performance_summary.log

summarize_memory:
	python summaries/memory_summary.py | tee output/summary/memory_summary.log
